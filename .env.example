# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# A chave "anon"/publishable é pública por design: o acesso é limitado por RLS
# (somente leitura). NUNCA coloque a service_role key aqui nem no repositório.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Voz natural (opcional). Sem estas, o site usa a voz do aparelho.
# Configure no painel da Vercel, nunca no repositório.
# OPENAI_API_KEY=        chave da OpenAI (platform.openai.com) para o TTS
# BLOB_READ_WRITE_TOKEN= criado automaticamente ao ligar um Vercel Blob ao projeto
# CRON_SECRET=           protege a rota agendada /api/cron/audio
# TTS_VOZ=coral          opcional: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse
